<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAS Access</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .file-list {
            max-height: 400px;
            overflow-y: auto;
        }
        .file-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            margin-bottom: 10px;
            background-color: #f8f9fa;
            transition: background-color 0.3s ease;
        }
        .file-list-item:hover {
            background-color: #e9ecef;
        }
        .file-name {
            font-weight: bold;
            color: #007bff;
            text-decoration: none;
        }
        .upload-container {
            margin-top: 20px;
            padding: 20px;
            border: 2px dashed #007bff;
            border-radius: 10px;
            background-color: #f8f9fa;
            text-align: center;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
        .upload-container.dragover {
            background-color: #e9ecef;
            border-color: #0056b3;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container py-5">
        <h2 class="text-center mb-4">NAS Access</h2>
        <p class="text-center">Manage shared files on the server. Download or upload files below.</p>

        <!-- File List -->
        <div class="file-list" id="file-list">
            <!-- 파일 목록이 동적으로 추가됩니다 -->
        </div>

        <!-- Upload Section -->
        <div class="upload-container" id="uploadContainer">
            <form id="uploadForm" action="/nas/upload" method="post" enctype="multipart/form-data">
                <input type="file" name="file" id="fileInput" class="d-none">
                <p>Drag & Drop your files here, or click to select files.</p>
                <button type="button" class="btn btn-primary mt-3" id="uploadButton">Upload File</button>
            </form>
        </div>
    </div>

    <script>
        const fileList = document.getElementById('file-list');
        const uploadContainer = document.getElementById('uploadContainer');
        const fileInput = document.getElementById('fileInput');
        const uploadForm = document.getElementById('uploadForm');
        const uploadButton = document.getElementById('uploadButton');

        // 파일 목록 업데이트 함수
        function updateFileList(files) {
            fileList.innerHTML = ''; // 기존 파일 목록 제거

            files.forEach(file => {
                const fileItem = document.createElement('div');
                fileItem.className = 'file-list-item';
                fileItem.innerHTML = `
                    <a href="/nas/download/${encodeURIComponent(file.name)}" class="file-name" download>${file.name}</a>
                    <span>${file.size ? formatFileSize(file.size) : ''}</span>
                `;
                fileList.appendChild(fileItem);
            });
        }

        // 파일 크기 포맷팅 함수
        function formatFileSize(bytes) {
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            if (bytes === 0) return '0 Bytes';
            const i = parseInt(Math.floor(Math.log(bytes) / Math.log(1024)), 10);
            return `${(bytes / Math.pow(1024, i)).toFixed(2)} ${sizes[i]}`;
        }

        // 드래그 앤 드롭 이벤트 처리
        uploadContainer.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadContainer.classList.add('dragover');
        });

        uploadContainer.addEventListener('dragleave', () => {
            uploadContainer.classList.remove('dragover');
        });

        uploadContainer.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadContainer.classList.remove('dragover');
            fileInput.files = e.dataTransfer.files;
        });

        // 클릭 시 파일 선택 창 열기
        uploadContainer.addEventListener('click', () => {
            fileInput.click();
        });

        // 업로드 버튼 클릭 시 폼 제출
        uploadButton.addEventListener('click', () => {
            if (fileInput.files.length === 0) {
                alert('Please select a file to upload.');
                return;
            }
            uploadForm.submit();
        });

        // 샘플 데이터로 파일 목록 초기화 (서버 연동 시 제거 가능)
        const sampleFiles = [
            { name: 'example1.txt', size: 1234 },
            { name: 'example2.jpg', size: 567890 },
            { name: 'example3.pdf', size: 12345678 },
        ];
        updateFileList(sampleFiles);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>