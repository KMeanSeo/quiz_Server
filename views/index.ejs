<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab Server</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <h1 class="text-center mb-4">Welcome to Lab Server</h1>
        <p class="text-center text-muted">Easily manage your messenger, network, and NAS in one place!</p>
        <div class="row text-center">
            <!-- 메신저 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Messenger</h5>
                        <p class="card-text">Chat with others in real time.</p>
                        <a href="/messenger" class="btn btn-primary">Go to Messenger</a>
                    </div>
                </div>
            </div>
            <!-- 네트워크 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Network Scanner</h5>
                        <p class="card-text">Scan and explore connected devices.</p>
                        <a href="/network" class="btn btn-secondary">Scan Network</a>
                    </div>
                </div>
            </div>
            <!-- NAS -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">NAS</h5>
                        <p class="card-text">Access shared files on the server.</p>
                        <a href="/nas" class="btn btn-success">Access NAS</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
